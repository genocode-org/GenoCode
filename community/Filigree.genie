// Shared by Jan under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/): https://github.com/genocode-org/GenoCode/issues/104
// About it: Filigree is a jewelled mandala with 18 variants,
creature Filigree
// A jewelled mandala. Arms of hoops, beads and paired petals step round a heart, each arm beside
// its own mirror image, in two tiers laid one over the other; where the arms curl across one
// another they weave lace, stars, flowers and whirlpools, and colour runs along every arm.
// It ripples and flaps to the music, its hoops swell with the bass, its beads flash on the high
// notes and its colours flow outwards; with no music it sways to a slow beat of its own.
// Its nineteen variants are other patterns from the same weave: Snowflake, Peacock, Lace, Orchid,
// Lotus, Coral, Sunflower, Crown, Dreamcatcher, Compass, Firework, Rosette, Gyroscope, Anemone,
// Urchin, Pinwheel, Harlequin, Galaxy and Nebula.

// --- The weave: how the arms are laid out ---

gene overall = 1.164 in 0.2..5 log // how big the whole creature is
gene folds = 6 in 3..12 // how many arms the outer tier has; between whole numbers, arms slide out of one another
gene twin_gap = 0.5 in 0..1 // how far each arm stands from its mirror image: 0 on top of it, 0.5 evenly between
gene hub = 0.5 in 0..3 // how far from the heart the arms start
gene sink = -0.48 in -5..5 // how far in front of the point the camera looks at the heart sits (behind it, below 0), to centre a cupped mandala
gene stride = 0.8 in 0.3..2 log // how far apart the links of an arm are
gene taper = 0.6 in 0.25..2.5 log // how big the last link is compared with the first
gene swell = 0.2 in 0..0.7 // how much the links grow and shrink in waves along an arm
gene swell_waves = 1.5 in 0..4 // how many of those waves an arm has
gene swell_start = 0 in 0..1 // where along the arm they start
gene bend = (12, 7, 0) in (-40, -40, -40)..(40, 40, 40) // how far each link turns from the last: curling in the plane, rising out of it, twisting round the arm
gene wander = (0, 0, 0) in (-40, -40, -40)..(40, 40, 40) // how far the links turn back and forth in waves: curl, rise and twist
gene wander_waves = (1.5, 1, 1) in (0, 0, 0)..(4, 4, 4) // how many of those waves an arm has
gene wander_start = (0, 0, 0) in (0, 0, 0)..(1, 1, 1) // where along the arm they start

// --- The inner tier: a second mandala laid over the first ---

gene inner_folds = 6 in 3..12 // how many arms the inner tier has
gene inner_size = 0.55 in 0.2..1.2 log // how big it is beside the outer tier
gene inner_turn = 30 in -90..90 // how far it is turned from the outer tier
gene inner_phase = 0.25 in 0..1 // how far its waves are shifted along its arms
gene inner_cup = -1 in -1.5..1.5 // how its arms rise compared with the outer tier's: -1 cups the other way
gene inner_lift = 0 in -2..2 // how far in front of the outer tier it floats

// --- The links: a hoop, a bead and two petals each ---

gene hoop_shape = ring from [ring, donut, tube]
gene hoop_size = (1, 1, 1) in (0.02, 0.02, 0.02)..(2.5, 2.5, 2.5) log // the hoops' size: across, up and through
gene hoop_tilt = 90 in 0..90 // how far the hoops lie back: 0 stands them across the arm, 90 lays them flat
gene hoop_flip = 0 in -90..90 // how much further every other hoop turns
gene bead_shape = ball from [ball, cube, donut]
gene bead_size = 0.3 in 0..1.2 // how big the beads in the hoops are
gene petal_shape = cone from [cone, ball, cube, tube]
gene petal_size = (0.3, 0.1, 1) in (0, 0.02, 0)..(1.2, 0.6, 3) // the petals' width, thickness and length
gene petal_flare = 50 in 0..150 // how far the petals spread from the arm
gene petal_lift = 0 in -80..80 // how far they tip out of the plane
gene petal_stalk = 0.3 in 0..1.5 // how far from the link they start
gene heart = 0.8 in 0..2.5 // how big the heart in the middle is

// --- Colour ---

gene hue = 190 in 0..360 // the hoops' hue next to the heart
gene hue_sweep = 120 in -360..360 // how far the hue travels from the heart to the tips
gene shimmer = 20 in 0..90 // how far the hue ripples to and fro along an arm
gene shimmer_bands = 2 in 0..5 // how many ripples
gene stripe = 0 in -180..180 // how far every other link's hue is shifted
gene saturation = 0.9 in 0.4..1 // how rich the colours are
gene shade = 0.3 in 0..0.95 // how dark the dark bands along an arm are
gene shade_bands = 1 in 0..4 // how many dark bands
gene shade_start = 0 in 0..1 // where the dark bands start: 0 leaves the heart end bright, 0.5 darkens it
gene petal_hue = 150 in -180..180 // the petals' hue, away from their hoop's
gene petal_shade = 0.2 in 0..0.9 // how much darker the petals are
gene bead_hue = 60 in -180..180 // the beads' and heart's hue, away from their hoop's
gene bead_white = 0.3 in 0..1 // how pale the beads are: 1 is pearl white
gene twin_hue = 0 in -180..180 // the mirror-image arms' hue, away from their twins'
gene inner_hue = 40 in -180..180 // the inner tier's hue, away from the outer tier's
gene gloss = 0.8 in 0..1 // how strong the highlights are
gene focus = 0.7 in 0..1 // how tight the highlights are

// --- Dancing ---

gene ripple = 0.06 in 0..0.15 // how far the arms' waves slide to and fro with the music
gene pulse = 0.35 in 0..0.6 // how much the hoops swell with the bass
gene flap = 22 in 0..45 // how far the petals flap with the middle of the music
gene rock = 12 in 0..30 // how far the inner tier rocks round against the outer
gene sparkle = 0.5 in 0..1 // how much the beads swell on the high notes
gene colour_drift = 0.12 in 0..0.5 // how fast the colour ripples flow outwards, in ripples a second
gene idle = 0.5 in 0..1 // how much it dances by itself when no music plays
gene idle_tempo = 0.5 in 0.2..1.5 // its own beats a second, when it dances by itself

// --- How the music moves it ---

let own_beat = frac(time * idle_tempo)
let listening = clamp(music.level * 4, 0, 1)
let swing = groove(wave(own_beat), wave(beat) * (0.4 + 0.6 * music.mid))
let pump = groove(0.5 * bump(own_beat), music.bass)
let glint = groove(0.4 * bump(frac(own_beat * 2)), music.high_hit)
let flow = time * colour_drift

// The beat it dances to: the music's when there is some, its own when there isn't, blended by how
// loud the music is so it slips from one to the other without a jerk.
function groove(by_itself, to_music) {
  return mix(idle * by_itself, to_music, listening)
}

// A size that has shrunk to nothing is kept a millionth above zero, so the shape stays in place
// but is far too small to see.
function shown(amount) {
  return max(amount, 0.000001)
}

// The colour at a place along an arm, with its hue shifted: the hue sweeps from the heart to the
// tip and ripples on the way, and dark bands cross it; beads are paler. The hue is worked out as a number, so it
// never leaps across the colour wheel while the creature morphs.
function tint(along, shift, darker, paler) {
  let ripples = shimmer * wave(shimmer_bands * along - flow)
  let band = 0.5 - 0.5 * cos(360 * (shade_bands * along + shade_start))
  return hsv(hue + shift + hue_sweep * along + ripples, saturation * (1 - paler), (1 - shade * band * (1 - paler)) * (1 - darker))
}

// --- The creature ---

grow overall
// The camera looks at this point. A flat mandala has its heart here; one whose arms rise into a
// cup or a ball sits back by `sink`, so the point stays in its middle.
focuspoint
move (0, 0, sink)

shape bead_shape
shine gloss
sharpness focus
colour hsv(hue + bead_hue, saturation * (1 - bead_white), 1)
lay { grow shown(heart * (1 + sparkle * glint)) }

branch {
  tier(folds, 0, 0, 1)
}
branch {
  move (0, 0, inner_lift)
  roll inner_turn + rock * swing
  grow inner_size
  tier(inner_folds, inner_hue, inner_phase, inner_cup)
}

// One mandala: thirteen places for arms, each arm beside its mirror image. The places step round
// both ways from the top, one gap at a time. With a whole number of arms they land exactly on one
// another, so a tier of five shows five; in between, the hidden arms slide out of the ones in front
// of them at full size, the same on the left as on the right, so the mandala is never lopsided.
part tier(count, shift, phase, cup) {
  for j from -6 to 6 {
    branch {
      roll j * 360 / count
      symmetric x {
        roll twin_gap * 180 / count
        pitch -90
        forward hub
        arm(shift + twin_hue * (1 - side) / 2, phase, cup)
      }
    }
  }
}

// One arm: eight links, each turned from the last by the bend and the wander.
part arm(shift, phase, cup) {
  for k from 0 to 7 {
    let along = k / 7
    let big = taper ^ along * (1 + swell * wave(swell_waves * along + swell_start + phase))
    let slide = phase + ripple * swing
    branch {
      grow big
      link(along, k % 2, shift)
    }
    forward stride * big
    yaw bend.x + wander.x * wave(wander_waves.x * along + wander_start.x + slide)
    pitch cup * (bend.y + wander.y * wave(wander_waves.y * along + wander_start.y + slide))
    roll bend.z + wander.z * wave(wander_waves.z * along + wander_start.z + slide)
  }
}

// One link: a hoop with a bead in it and a petal on each side.
part link(along, odd, shift) {
  let here = shift + stripe * odd
  // The bass swells the hoops in a wave that runs out along the arm.
  let throb = 1 + pulse * pump * (0.6 + 0.4 * wave(along - own_beat - beat))

  shine gloss
  sharpness focus
  shape hoop_shape
  colour tint(along, here, 0, 0)
  lay { pitch hoop_tilt + hoop_flip * odd; grow hoop_size * throb }

  shape bead_shape
  colour tint(along, here + bead_hue, 0, bead_white)
  lay { grow shown(bead_size * (1 + sparkle * glint)) }

  // Petals are flat, so they have no shine: a flat face would flash white in the light.
  shine 0
  shape petal_shape
  colour tint(along, here + petal_hue, petal_shade, 0)
  symmetric x {
    yaw petal_flare + flap * swing
    pitch petal_lift
    forward petal_stalk + petal_size.z / 2
    lay { grow petal_size + (0.000001, 0.000001, 0.000001) }
  }
}



// A mandala is at its best seen face-on, so it often turns flat to the viewer and spins like a
// wheel, then tumbles again; the middle of the music carries it from one pattern to the next.
dance {
  gene drive = 0.6 in 0.1..2.5 // how fast the music moves it from pattern to pattern, in patterns a second
  gene top_spin = 110 in 30..300 // how fast it spins when the music is loudest, in degrees a second

  morph follows music.mid speed drive settle 3
  zoom follows music.bass_hit amount 0.3 settle 5
  spin follows music.level from 12 to top_spin smooth 1.2
  turn on music.mid changes by 0.6
  reverse on music.bass drops by 0.5 on 8 off 8
  flat on music.level drops by 0.6 on 16 off 12
}

// --- The family: twenty patterns from one weave ---

