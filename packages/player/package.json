{
  "name": "@genocode/player",
  "version": "0.0.0",
  "private": true,
  "description": "The GenoCode player: a phone app that morphs creatures and makes them dance to music.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@genocode/core": "^0.11.0",
    "@genocode/music": "^0.0.0",
    "@genocode/render": "^0.13.0",
    "@genocode/stage": "^0.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "vite": "8.3.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "vite build && cap sync",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:aab": "npm run sync && cd android && ./gradlew bundleRelease"
  }
}
